  "suppressSchemaAvailability": true,
  "faqSchema": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Which Readymade Office Cabin sizes are published?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Six standard sizes are published: 10x10, 20x8, 20x10, 20x12, 30x10 and 40x10 ft. Their floor areas run from 100 to 400 sq ft, and each published size is 8.5 ft high."
        }
      },
      {
        "@type": "Question",
        "name": "How is a Readymade Office Cabin different from the Portable Office range?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This specialist page uses one approved fixed inclusion list for its six published sizes. Availability is confirmed with the written quotation; this page does not make a stock or dispatch-from-stock claim."
        }
      },
      {
        "@type": "Question",
        "name": "Do the published prices include GST?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The table shows both ex-GST and inclusive prices. GST is 18% under HSN 9406."
        }
      },
      {
        "@type": "Question",
        "name": "Can the fixed inclusion list be changed?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The published prices apply to the approved fixed inclusion list. Other requirements are reviewed and priced separately in the written quotation."
        }
      },
      {
        "@type": "Question",
        "name": "How quickly will I receive a quotation and delivery?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "SAMAN returns a written quotation within 48 hours. Delivery is 7–21 working days after the order and site requirements are confirmed."
        }
      },
      {
        "@type": "Question",
        "name": "How are freight and warranty handled?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Delivery is free within Bangalore city and Delhi NCR, while freight outside those zones is quoted separately. The warranty is five years for the structure and one year for finishing, subject to the written terms."
        }
      }
    ]
  },
  "descriptionHtml": "<section><h2>Readymade Office Cabin range</h2><p>This specialist range uses one approved fixed inclusion list across six published sizes. Availability is confirmed with the written quotation; no stock or dispatch-from-stock promise is made on this page.</p><h3>Six published sizes and prices</h3><div class=\"overflow-x-auto\"><table><thead><tr><th>Size</th><th>Area</th><th>Price ex-GST</th><th>Price incl. 18% GST</th></tr></thead><tbody><tr><td>10×10 ft</td><td>100 sq ft</td><td>₹1,41,100</td><td>₹1,66,498</td></tr><tr><td>20×8 ft</td><td>160 sq ft</td><td>₹2,25,760</td><td>₹2,66,397</td></tr><tr><td>20×10 ft</td><td>200 sq ft</td><td>₹2,56,400</td><td>₹3,02,552</td></tr><tr><td>20×12 ft</td><td>240 sq ft</td><td>₹2,95,440</td><td>₹3,48,619</td></tr><tr><td>30×10 ft</td><td>300 sq ft</td><td>₹3,69,300</td><td>₹4,35,774</td></tr><tr><td>40×10 ft</td><td>400 sq ft</td><td>₹4,82,400</td><td>₹5,69,232</td></tr></tbody></table></div><p>Prices use HSN 9406 and apply to the approved fixed inclusion list. Other requirements are priced separately in writing.</p></section><section><h2>Quotation and zonal contacts</h2><p>A written quotation is returned within 48 hours. Delivery is 7–21 working days after the order and site requirements are confirmed. Delivery is free within Bangalore city and Delhi NCR; freight outside those zones is quoted separately.</p><p><strong>South India:</strong> <a href=\"tel:+918861622859\">+91 88616 22859</a><br/><strong>North India:</strong> <a href=\"tel:+918796039938\">+91 87960 39938</a></p><p>Warranty: five-year structural warranty and one-year finishing warranty, subject to the written warranty and quotation terms.</p></section><section><h2>Verified company credentials</h2><p>SAMAN POS India Private Limited maintains the following repository-backed credentials:</p><ul><li><a href=\"/certifications/saman-pos-iso-9001-2015-quality-management-certificate.pdf\">ISO 9001:2015 quality management certificate</a>, subject to the conditions stated in the certificate</li><li><a href=\"/certifications/saman-pos-gst-karnataka-certificate.pdf\">GST registration, Karnataka</a> and <a href=\"/certifications/saman-pos-gst-uttar-pradesh-greater-noida-certificate.pdf\">GST registration, Uttar Pradesh</a></li><li><a href=\"/certifications/saman-pos-udyam-registration-certificate.pdf\">Udyam registration</a></li><li><a href=\"/certifications/saman-pos-startup-india-recognition-certificate.pdf\">DPIIT Startup India recognition</a></li><li><a href=\"/certifications/saman-pos-nsic-government-purchase-enlistment.pdf\">NSIC Government Purchase enlistment</a></li></ul></section><section><h2>Frequently asked questions</h2><dl><div><dt><strong>Which Readymade Office Cabin sizes are published?</strong></dt><dd>Six standard sizes are published: 10x10, 20x8, 20x10, 20x12, 30x10 and 40x10 ft. Their floor areas run from 100 to 400 sq ft, and each published size is 8.5 ft high.</dd></div><div><dt><strong>How is a Readymade Office Cabin different from the Portable Office range?</strong></dt><dd>This specialist page uses one approved fixed inclusion list for its six published sizes. Availability is confirmed with the written quotation; this page does not make a stock or dispatch-from-stock claim.</dd></div><div><dt><strong>Do the published prices include GST?</strong></dt><dd>The table shows both ex-GST and inclusive prices. GST is 18% under HSN 9406.</dd></div><div><dt><strong>Can the fixed inclusion list be changed?</strong></dt><dd>The published prices apply to the approved fixed inclusion list. Other requirements are reviewed and priced separately in the written quotation.</dd></div><div><dt><strong>How quickly will I receive a quotation and delivery?</strong></dt><dd>SAMAN returns a written quotation within 48 hours. Delivery is 7–21 working days after the order and site requirements are confirmed.</dd></div><div><dt><strong>How are freight and warranty handled?</strong></dt><dd>Delivery is free within Bangalore city and Delhi NCR, while freight outside those zones is quoted separately. The warranty is five years for the structure and one year for finishing, subject to the written terms.</dd></div></dl></section>"
}
