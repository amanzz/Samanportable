{
  "register": "merchant-feed-suppression",
  "version": 1,
  "created": "2026-08-06",
  "status": "ACTIVE — STOPGAP",
  "defends_against": "A WooCommerce re-export of src/data/wp-export/products/*.json drops the priceSubline field. That silently un-arms hasMerchantUnsafePrice() (src/lib/merchantFeed.ts:192), and every entry below returns to the Google Merchant feed carrying an ex-GST price into India, which is a tax-inclusive market. There is no error, no warning, and validate:merchant-feed still passes, because the items simply reappear as valid rows. The failure is silent and the feed count is the only symptom.",
  "mechanism": {
    "guard": "hasMerchantUnsafePrice()",
    "source": "src/lib/merchantFeed.ts:192-201",
    "test": "priceDisplay or priceSubline matches /\\bex\\s*-?\\s*gst\\b/i",
    "effect": "product excluded from the feed",
    "skip_reason_emitted": "tax_exclusive_price_not_merchant_safe",
    "note": "The guard tests for the ex-GST TOKEN in a caption, not for the price basis itself. It is a caption-driven stopgap, not a reconciliation."
  },
  "supersession": {
    "ticket": "T3",
    "plan": "T3 excludes these items by reconciliation against the approved matrix instead of by caption token, then reverts every priceSubline edit listed below.",
    "ruling": "R5-5"
  },
