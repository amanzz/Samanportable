        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much do shipping container homes cost?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "SAMAN's shipping container homes start from around ₹12 lakh for a single-unit configuration and reach ₹56,35,000 for the 3,300 sq ft multi-unit flagship. The number is driven by container count, layout, and finish. For a full breakdown of what moves the price, see our container home cost guide for India.\n"
            }
          },
          {
            "@type": "Question",
            "name": "How big are shipping container homes?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A single 20-ft unit gives roughly 160 sq ft and a 40-ft unit about 320 sq ft. Joining and stacking containers scales the home up — SAMAN configures builds up to 3,300 sq ft for full family living.\n"
            }
          },
          {
            "@type": "Question",
            "name": "How long do shipping container homes last?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "With proper insulation, a finished interior, and routine maintenance, a shipping container home comfortably serves 15–20 years and beyond. Sealed surfaces and quality finishing are what protect the steel and keep the home livable long-term.\n"
            }
          },
          {
            "@type": "Question",
            "name": "What's the difference between a shipping container home and a tiny container home?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A tiny container home is a single small unit built for minimalist or weekend living. A full-size shipping container home combines multiple containers into a larger, family-scale residence — same format, larger footprint."
            }
          }
        ]
      }
